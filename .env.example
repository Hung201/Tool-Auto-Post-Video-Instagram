# ==========================================================
#  Instagram Auto Poster - Cấu hình (copy file này thành .env)
# ==========================================================

# --- Chọn cách đăng bài ---
# graph      = Facebook Graph API (chính thống, CẦN Instagram Business nối Facebook Page)
# instagram  = Instagram Login API (chính thống, KHÔNG cần Facebook Page) -> xem HUONG-DAN-INSTAGRAM-LOGIN.md
# instagrapi = private API (chỉ cần user/pass, vi phạm ToS, dễ bị khóa)
PUBLISHER=instagram

# ==========================================================
#  A) NẾU DÙNG GRAPH API (PUBLISHER=graph)
# ==========================================================
# 1 tài khoản: điền ở đây. Nhiều tài khoản: dùng config/accounts.json.
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=EAAG...long_lived_page_access_token...
IG_USERNAME=ten_hien_thi   # chỉ để hiển thị / ghi lịch sử

# --- Media host: nơi chứa video công khai để Instagram tải về ---
# cloudinary  = upload lên Cloudinary (đơn giản nhất)
# public_dir  = copy vào thư mục web server của bạn
MEDIA_HOST=cloudinary

# Cloudinary (lấy tại dashboard cloudinary.com). Có thể dùng CLOUDINARY_URL gộp:
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Hoặc tách riêng:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nếu MEDIA_HOST=public_dir (tự host qua web server của bạn):
PUBLIC_BASE_URL=https://cdn.mienphi.com/videos
PUBLIC_SERVE_DIR=C:/www/videos

# --- Location (địa điểm) gắn vào mỗi bài (tùy chọn) ---
# Mã Facebook Places. 212988918 = New York, New York. Để trống = không gắn location.
IG_LOCATION_ID=212988918

# ==========================================================
#  B) NẾU DÙNG INSTAGRAPI (PUBLISHER=instagrapi)
# ==========================================================
IG_PASSWORD=mat_khau_insta_cua_ban
# (IG_USERNAME dùng chung ở trên)

# ==========================================================
#  AI sinh text
# ==========================================================
# Ưu tiên: lovable (mặc định) | anthropic | gemini. Lỗi -> tự chuyển provider còn lại.
AI_PROVIDER=lovable

# --- Lovable AI Gateway (OpenAI-compatible) ---
LOVABLE_API_KEY=sk_...
LOVABLE_MODEL=google/gemini-2.5-flash

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY đọc trực tiếp từ môi trường, không cần khai ở đây.
ANTHROPIC_MODEL=claude-opus-5
# Muốn rẻ hơn cho việc sinh 1 câu quote (chạy nhiều lần/ngày), có thể dùng:
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Google Gemini (nếu AI_PROVIDER=gemini) ---
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# ==========================================================
#  Nguồn video
# ==========================================================
# composite = TỰ GHÉP: 1 clip mở đầu (first-video) + 2 clip (second-video) + nhạc (music)
# single    = lấy 1 file có sẵn trong INPUTS_DIR
VIDEO_SOURCE=composite

# --- Kho video để ghép (dùng khi VIDEO_SOURCE=composite) ---
FIRST_VIDEO_DIR=E:\Hung\drop-shipping\first-video
SECOND_VIDEO_DIR=E:\Hung\drop-shipping\second-video
BUILD_MUSIC_DIR=E:\Hung\drop-shipping\music
SECOND_COUNT=3
# true = (A,B) khác (B,A) -> gấp đôi số tổ hợp (275 -> 550). false = coi như nhau.
SECOND_ORDER_MATTERS=true
# Độ dài chuyển cảnh fade giữa các clip (giây). 0 = cắt thẳng, nhịp nhanh.
FADE_DURATION=0.5

# Nơi lưu MỌI video tạo ra (để bạn xem lại). Không tự xoá.
OUTPUT_DIR=E:\Hung\drop-shipping\output

# --- Chế độ single (VIDEO_SOURCE=single) ---
VIDEO_PATH=inputs/video_goc.mp4
INPUTS_DIR=inputs
USE_RANDOM_MUSIC=false
MUSIC_DIR=music

# ==========================================================
#  Prompt / Hashtag
# ==========================================================
PROMPT_TEXT=Write ONE funny, punchy English hook (max 10 words) about pet hair being everywhere and needing a grooming/deshedding brush for cats and dogs.
# LƯU Ý: phải bọc trong dấu nháy kép "..." vì dấu # có khoảng trắng trước bị dotenv cắt làm comment.
CAPTION_HASHTAGS="#petgrooming #petbrush #deshedding #petgroomingtools #sheddingseason #furremover #petcare #pethacks #petproducts #petmusthaves #petfinds #dogsofinstagram #catsofinstagram #petsofinstagram #dogsofinsta #catsofinsta #instapet #petstagram #doglover #catlover #petlovers #dogmom #catmom #furbaby #tiktokmademebuyit #amazonfinds #amazonmusthaves #reels #fyp #viral"

# Vị trí chữ trên video: top (như mẫu) | center | bottom
TEXT_POSITION=top
# Cỡ chữ theo % chiều cao video. 0.038 = nhỏ gọn. Tăng lên 0.045 nếu muốn to hơn.
TEXT_SCALE=0.038

# true = giữ nguyên màu gốc (không chỉnh sáng/tương phản). false = chỉnh nhẹ để né trùng.
KEEP_ORIGINAL_COLOR=true

# ==========================================================
#  Lịch & chế độ chạy
# ==========================================================
MIN_HOURS=1.0
MAX_HOURS=2.0
RUN_MODE=loop           # once = test 1 bài/account; loop = chạy liên tục
DELAY_BEFORE_FIRST=false

# --- Giờ vàng Mỹ: chỉ đăng vào khung cao điểm (target khán giả US) ---
# true = chỉ đăng trong giờ vàng | false = đăng mọi lúc
USE_PEAK_HOURS=true
# Múi giờ canh: America/Chicago (giữa nước Mỹ) | America/New_York | America/Los_Angeles
POSTING_TIMEZONE=America/Chicago
# Khung giờ cao điểm (giờ theo múi giờ trên), nhiều khung cách nhau bằng dấu phẩy
PEAK_WINDOWS=11-14,19-22
